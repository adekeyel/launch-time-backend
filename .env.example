# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL (Railway provides this automatically as DATABASE_URL when you
# add a PostgreSQL plugin to your Railway project)
DATABASE_URL=postgresql://user:password@localhost:5432/launch_time
PGSSL=false

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password reset
RESET_TOKEN_EXPIRES_MIN=30

# Resend (https://resend.com) - email provider
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="LAUNCH TIME <onboarding@resend.dev>"

# Cloudinary (https://cloudinary.com/console) - image & short-video storage
# Find these on your Cloudinary dashboard home page.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Flutterwave (https://dashboard.flutterwave.com/settings/apis) - card payments
# FLW_SECRET_KEY: your secret key from the dashboard above.
# FLW_WEBHOOK_HASH: a secret string YOU make up — set this exact same value
# in the Flutterwave dashboard under Settings > Webhooks > Secret Hash.
FLW_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLW_WEBHOOK_HASH=change_this_to_a_long_random_string

# Super admin bootstrap (used by database/seed.js to create the first admin)
SUPER_ADMIN_EMAIL=admin@launchtime.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_FULLNAME=Super Admin
